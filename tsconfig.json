{
  "compilerOptions": {
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "esModuleInterop": true,
    "declaration": true,
    "typeRoots": [
      "./node_modules/@types",
      "./scripts/types"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "outDir": "./dist"
  },
  "include": [
    "server.ts",
    "scripts/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests/__data__/output"
  ]
}